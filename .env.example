# Copy to .env and fill in your values. docker compose reads .env automatically.
# All ${VAR:?...} variables in docker-compose.yml are MANDATORY — the stack
# will refuse to start without them. Generate strong values, e.g.:
#   openssl rand -base64 32

# ── QRadar acknowledged delivery ─────────────────────────────────────────────
# Production uses the selected idempotent HTTPS gateway. The receiver must
# durably persist request_id before returning status=accepted or status=duplicate.
QRADAR_HOST=your-qradar-host-or-ip
QRADAR_PROTOCOL=https_ack
QRADAR_PORT=514
QRADAR_GATEWAY_URL=https://qradar-gateway.example.com/v1/events
QRADAR_GATEWAY_HMAC_SECRET=replace-with-openssl-rand-base64-32
QRADAR_GATEWAY_TIMEOUT_SECONDS=10
# Optional private CA and mTLS client identity paths inside the container.
QRADAR_GATEWAY_CA_FILE=
QRADAR_GATEWAY_CLIENT_CERT_FILE=
QRADAR_GATEWAY_CLIENT_KEY_FILE=

# ── Automated response gateway ───────────────────────────────────────────────
# Keep dry_run until allowlists and gateway behavior are validated in staging.
LOGFILTER_RESPONSE_MODE=dry_run
LOGFILTER_RESPONSE_KILL_SWITCH=false
LOGFILTER_RESPONSE_BLOCK_THRESHOLD=0.85
LOGFILTER_RESPONSE_ALLOWED_NETWORKS=
LOGFILTER_RESPONSE_ALLOWED_HOSTS=
LOGFILTER_RESPONSE_MAX_ACTIONS_PER_MINUTE=60
LOGFILTER_RESPONSE_GATEWAY_URL=https://response-gateway.example.com/v1/actions
LOGFILTER_RESPONSE_GATEWAY_HMAC_SECRET=replace-with-openssl-rand-base64-32
LOGFILTER_RESPONSE_GATEWAY_TIMEOUT_SECONDS=10
LOGFILTER_RESPONSE_GATEWAY_CA_FILE=
LOGFILTER_RESPONSE_GATEWAY_CLIENT_CERT_FILE=
LOGFILTER_RESPONSE_GATEWAY_CLIENT_KEY_FILE=
# ── API ───────────────────────────────────────────────────────────────────────
# REQUIRED. Used by POST /score and POST /score/batch.
LOGFILTER_API_TOKEN=replace-with-openssl-rand-base64-32
# REQUIRED. Used by /metrics and /metrics/snapshot endpoints.
LOGFILTER_METRICS_TOKEN=replace-with-openssl-rand-base64-32
# Disabled by default to avoid exposing OpenAPI metadata in deployed services.
LOGFILTER_ENABLE_DOCS=0
LOGFILTER_MODELS_STRICT=0
# Set to the origin(s) of your browser-based frontend (comma-separated).
# Example: CORS_ALLOW_ORIGINS=https://logfilter.yourcompany.com
# Leave empty in headless deployments (no browser clients).
# Localhost origins are only accepted in dev mode (LOGFILTER_ENABLE_DOCS=1).
CORS_ALLOW_ORIGINS=

# ── Runtime threshold tuning ───────────────────────────────────────────────────
# Keep defaults until you have reviewed scripts/evaluate_tier2_thresholds.py output
# against representative logs. Invalid values fail service startup/reload.
LOGFILTER_TIER2_UNCERTAINTY_LOW=0.10
LOGFILTER_TIER2_UNCERTAINTY_HIGH=0.90
LOGFILTER_SCORE_HIGH=0.80
LOGFILTER_SCORE_MEDIUM=0.50
LOGFILTER_SCORE_LOW=0.20

# Optional domain models. Train/provision the manifest-verified artifacts before
# enabling these flags (see Makefile targets train-flow and train-endpoint).
LOGFILTER_FLOW_ENABLED=false
LOGFILTER_BOT_FLOW_ENABLED=false
LOGFILTER_BOT_FLOW_TARGET_FPR=0.01
LOGFILTER_FLOW_WINDOW_ENABLED=false
LOGFILTER_ENDPOINT_NOVELTY_ENABLED=false

# ── Model artifact paths ───────────────────────────────────────────────────────
# Overrides for artifact locations. Only change these if you relocate models/.
LOGFILTER_CLASSIFIER_PATH=models/log_classifier.onnx
# Shared HuggingFace cache. Set to a mounted volume for air-gapped deployments.
HF_HOME=
# Reported as the scorer's model_version in /health responses.
LOGFILTER_MODEL_VERSION=

# ── Transformer component toggles ─────────────────────────────────────────────
# Tier-3 model loading switches. All default to enabled; set false to skip a
# component that has no installed artifact (its LEEF fields then stay empty).
LOGFILTER_NER_ENABLED=true
LOGFILTER_BIENCODER_ENABLED=true
LOGFILTER_CROSS_ENCODER_ENABLED=true
# Sigma rule matching. Disabling removes the Sigma → HIGH routing override.
LOGFILTER_SIGMA_ENABLED=true

# ── Novelty and drift monitoring ──────────────────────────────────────────────
# Rolling-baseline novelty detector. Disabled by default.
LOGFILTER_NOVELTY_ENABLED=false
# PSI feature-drift detection. Disabled by default.
LOGFILTER_DRIFT_ENABLED=false
# Automatically fall back to tier-1-only scoring when drift exceeds the threshold.
LOGFILTER_DRIFT_AUTO_FALLBACK=true

# ── Flow model (firewall_flow source profile) ─────────────────────────────────
# Artifact paths for the CICFlowMeter numeric classifier and its fusion policy.
LOGFILTER_FLOW_MODEL_PATH=models/flow/flow_classifier.onnx
LOGFILTER_FLOW_SCALER_PATH=models/flow/scaler.json
LOGFILTER_FLOW_FEATURES_PATH=models/flow/feature_names.json
LOGFILTER_FLOW_FUSION_CALIBRATION=models/flow/fusion_calibration.json
# Validation-only false-positive target used to select the fusion policy.
LOGFILTER_FLOW_FUSION_TARGET_FPR=0.01
# Routing thresholds for firewall_flow events. These OVERRIDE LOGFILTER_SCORE_*.
LOGFILTER_FLOW_SCORE_HIGH=0.80
LOGFILTER_FLOW_SCORE_MEDIUM=0.50
LOGFILTER_FLOW_SCORE_LOW=0.20

# ── Bot flow head ─────────────────────────────────────────────────────────────
# Separate Bot-vs-rest head, fused through validation-only policies. The
# general head alone has 0% Bot recall, so bot traffic needs this enabled.
LOGFILTER_BOT_FLOW_MODEL_PATH=models/flow/bot_classifier.onnx
LOGFILTER_BOT_FLOW_SCALER_PATH=models/flow/bot_scaler.json
LOGFILTER_BOT_FLOW_FEATURES_PATH=models/flow/bot_feature_names.json
LOGFILTER_BOT_FLOW_CALIBRATION=models/flow/bot_calibration.json
# Minimum bot score required to raise an alert.
LOGFILTER_BOT_FLOW_ALERT_FLOOR=0.65

# ── Endpoint novelty model (BETH open-set proxy) ──────────────────────────────
LOGFILTER_ENDPOINT_NOVELTY_PATH=models/endpoint/endpoint_novelty.onnx
LOGFILTER_ENDPOINT_NOVELTY_CONFIG=models/endpoint/novelty_config.json
# Maps IsolationForest distance onto a 0.0-1.0 novelty score.
LOGFILTER_ENDPOINT_NOVELTY_SCALE=0.03

# ── HTTP lexical routing thresholds ────────────────────────────────────────────
# Routing thresholds for firewall_http events. These OVERRIDE LOGFILTER_SCORE_*.
LOGFILTER_HTTP_SCORE_HIGH=0.80
LOGFILTER_HTTP_SCORE_MEDIUM=0.50
LOGFILTER_HTTP_SCORE_LOW=0.20

# ── DDoS flow window ───────────────────────────────────────────────────────────
# In-process 10s destination/protocol window. Single-worker/validation only —
# an HA deployment must externalize this state before enforcement use.
LOGFILTER_FLOW_WINDOW_SECONDS=10
LOGFILTER_FLOW_WINDOW_MAX_KEYS=10000
LOGFILTER_FLOW_WINDOW_MAX_EVENTS=5000
# Per-window trip points that raise the DDoS signal.
LOGFILTER_DDOS_FLOW_THRESHOLD=200
LOGFILTER_DDOS_PACKET_THRESHOLD=20000
LOGFILTER_DDOS_BYTE_THRESHOLD=10000000
LOGFILTER_DDOS_SOURCE_THRESHOLD=50

# ── Elasticsearch redaction ────────────────────────────────────────────────────
# Redaction of archived raw-log fields. IPs and hostnames are investigation
# signals and are kept unless your privacy posture requires removing them.
LOGFILTER_REDACTION_ENABLED=true
LOGFILTER_REDACT_EMAILS=true
LOGFILTER_REDACT_CREDIT_CARDS=true
LOGFILTER_REDACT_SECRETS=true
LOGFILTER_REDACT_IP_ADDRESSES=false
LOGFILTER_REDACT_HOSTNAMES=false

# ── API runtime ───────────────────────────────────────────────────────────────
# Enables the Redis-backed distributed rate limiter. Without it the API falls
# back to per-process counters, which are ineffective behind multiple replicas.
REDIS_URL=redis://redis:6379/0
# Seconds the /health probe may reuse a cached readiness result.
LOGFILTER_HEALTH_CACHE_SECONDS=1
# Seconds between Redis reconnect attempts.
LOGFILTER_REDIS_RETRY_SECONDS=1
# Comma-separated proxy CIDRs whose X-Forwarded-For headers are trusted.
LOGFILTER_TRUSTED_PROXIES=

# ── Router ────────────────────────────────────────────────────────────────────
# Base URL of the scoring API the router calls.
LOGFILTER_API_URL=http://logfilter-api:8080
# Kafka consumer poll timeout in milliseconds.
ROUTER_POLL_TIMEOUT_MS=1000

# ── Collector listeners and spool ──────────────────────────────────────────────
SYSLOG_LISTEN_HOST=0.0.0.0
SYSLOG_LISTEN_PORT=5140
SYSLOG_METRICS_PORT=9100
# Durable on-disk fallback used when Kafka publish fails. Leaving this empty disables
# spooling; under Compose the default resolves to the collector-spool volume so a
# Kafka outage spools instead of dropping every syslog event.
SYSLOG_SPOOL_PATH=/app/spool/collector.ndjson
# Spool size cap in bytes and drain interval in seconds.
SYSLOG_MAX_SPOOL_BYTES=50000000
SYSLOG_SPOOL_DRAIN_INTERVAL=30.0
# TCP listener hardening.
SYSLOG_MAX_TCP_LINE_BYTES=1048576
SYSLOG_MAX_TCP_CONNECTIONS=256

# ── OpenTelemetry tracing ─────────────────────────────────────────────────────
# Optional. Services emit OTLP traces when the telemetry extra is installed.
OTEL_SERVICE_NAME=logfilter
OTEL_EXPORTER_OTLP_ENDPOINT=http://otel-collector:4317
OTEL_EXPORTER_OTLP_PROTOCOL=grpc

# ── Elasticsearch ─────────────────────────────────────────────────────────────
# REQUIRED. Stack will not start without this.
ES_HOST=http://elasticsearch:9200
ES_USER=elastic
ES_PASSWORD=replace-with-openssl-rand-base64-32

# Number of index replicas for the raw-log archive. 0 is correct for the
# single-node dev stack. The HA overlay (docker-compose.prod.yml) overrides this
# to 2 in-cluster, because it forms a 3-node Elasticsearch cluster where 0 copies
# would leave the archive unreplicated.
LOGFILTER_ES_INDEX_REPLICAS=0

# ── Grafana ───────────────────────────────────────────────────────────────────
# REQUIRED. Default 'admin/admin' has been removed.
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=replace-with-openssl-rand-base64-32

# ── Alertmanager ───────────────────────────────────────────────────────────────
ALERT_WEBHOOK_URL=

# ── Kafka ─────────────────────────────────────────────────────────────────────
KAFKA_BOOTSTRAP_SERVERS=kafka:29092
# Runtime Kafka clients consume these values. Local Compose defaults to PLAINTEXT;
# production should use SASL_SSL with broker-side TLS and credentials.
KAFKA_SECURITY_PROTOCOL=PLAINTEXT
KAFKA_SASL_MECHANISM=
KAFKA_SASL_USERNAME=
KAFKA_SASL_PASSWORD=
KAFKA_SSL_CAFILE=
KAFKA_SSL_CERTFILE=
KAFKA_SSL_KEYFILE=
KAFKA_SSL_PASSWORD=
KAFKA_SSL_CHECK_HOSTNAME=true
# Consumer group timing. Raising max_poll_interval_ms without raising
# session_timeout_ms risks the broker evicting a slow consumer.
KAFKA_MAX_POLL_INTERVAL_MS=900000
KAFKA_SESSION_TIMEOUT_MS=45000

# ── Collector ─────────────────────────────────────────────────────────────────
# Local-only by default. Set trusted source CIDRs when receiving real syslog.
SYSLOG_ALLOWED_CIDRS=127.0.0.1/32,::1/128,172.16.0.0/12
# Kibana service token for ES
KIBANA_SERVICE_TOKEN=
