# Copy to .env and fill in your values. docker compose reads .env automatically.
# All ${VAR:?...} variables in docker-compose.yml are MANDATORY — the stack
# will refuse to start without them. Generate strong values, e.g.:
#   openssl rand -base64 32

# ── QRadar acknowledged delivery ─────────────────────────────────────────────
# Production uses the selected idempotent HTTPS gateway. The receiver must
# durably persist request_id before returning status=accepted or status=duplicate.
QRADAR_HOST=your-qradar-host-or-ip
QRADAR_PROTOCOL=https_ack
QRADAR_PORT=514
QRADAR_GATEWAY_URL=https://qradar-gateway.example.com/v1/events
QRADAR_GATEWAY_HMAC_SECRET=replace-with-openssl-rand-base64-32
QRADAR_GATEWAY_TIMEOUT_SECONDS=10
# Optional private CA and mTLS client identity paths inside the container.
QRADAR_GATEWAY_CA_FILE=
QRADAR_GATEWAY_CLIENT_CERT_FILE=
QRADAR_GATEWAY_CLIENT_KEY_FILE=

# ── Automated response gateway ───────────────────────────────────────────────
# Keep dry_run until allowlists and gateway behavior are validated in staging.
LOGFILTER_RESPONSE_MODE=dry_run
LOGFILTER_RESPONSE_KILL_SWITCH=false
LOGFILTER_RESPONSE_BLOCK_THRESHOLD=0.85
LOGFILTER_RESPONSE_ALLOWED_NETWORKS=
LOGFILTER_RESPONSE_ALLOWED_HOSTS=
LOGFILTER_RESPONSE_MAX_ACTIONS_PER_MINUTE=60
LOGFILTER_RESPONSE_GATEWAY_URL=https://response-gateway.example.com/v1/actions
LOGFILTER_RESPONSE_GATEWAY_HMAC_SECRET=replace-with-openssl-rand-base64-32
LOGFILTER_RESPONSE_GATEWAY_TIMEOUT_SECONDS=10
LOGFILTER_RESPONSE_GATEWAY_CA_FILE=
LOGFILTER_RESPONSE_GATEWAY_CLIENT_CERT_FILE=
LOGFILTER_RESPONSE_GATEWAY_CLIENT_KEY_FILE=
# ── API ───────────────────────────────────────────────────────────────────────
# REQUIRED. Used by POST /score and POST /score/batch.
LOGFILTER_API_TOKEN=replace-with-openssl-rand-base64-32
# REQUIRED. Used by /metrics and /metrics/snapshot endpoints.
LOGFILTER_METRICS_TOKEN=replace-with-openssl-rand-base64-32
# Disabled by default to avoid exposing OpenAPI metadata in deployed services.
LOGFILTER_ENABLE_DOCS=0
LOGFILTER_MODELS_STRICT=0
# Set to the origin(s) of your browser-based frontend (comma-separated).
# Example: CORS_ALLOW_ORIGINS=https://logfilter.yourcompany.com
# Leave empty in headless deployments (no browser clients).
# Localhost origins are only accepted in dev mode (LOGFILTER_ENABLE_DOCS=1).
CORS_ALLOW_ORIGINS=

# ── Runtime threshold tuning ───────────────────────────────────────────────────
# Keep defaults until you have reviewed scripts/evaluate_tier2_thresholds.py output
# against representative logs. Invalid values fail service startup/reload.
LOGFILTER_TIER2_UNCERTAINTY_LOW=0.10
LOGFILTER_TIER2_UNCERTAINTY_HIGH=0.90
LOGFILTER_SCORE_HIGH=0.80
LOGFILTER_SCORE_MEDIUM=0.50
LOGFILTER_SCORE_LOW=0.20

# Optional domain models. Train/provision the manifest-verified artifacts before
# enabling these flags (see Makefile targets train-flow and train-endpoint).
LOGFILTER_FLOW_ENABLED=false
LOGFILTER_BOT_FLOW_ENABLED=false
LOGFILTER_BOT_FLOW_TARGET_FPR=0.01
LOGFILTER_FLOW_WINDOW_ENABLED=false
LOGFILTER_ENDPOINT_NOVELTY_ENABLED=false

# ── OpenTelemetry tracing ─────────────────────────────────────────────────────
# Optional. Services emit OTLP traces when the telemetry extra is installed.
OTEL_SERVICE_NAME=logfilter
OTEL_EXPORTER_OTLP_ENDPOINT=http://otel-collector:4317
OTEL_EXPORTER_OTLP_PROTOCOL=grpc

# ── Elasticsearch ─────────────────────────────────────────────────────────────
# REQUIRED. Stack will not start without this.
ES_HOST=http://elasticsearch:9200
ES_USER=elastic
ES_PASSWORD=replace-with-openssl-rand-base64-32

# ── Grafana ───────────────────────────────────────────────────────────────────
# REQUIRED. Default 'admin/admin' has been removed.
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=replace-with-openssl-rand-base64-32

# ── Alertmanager ───────────────────────────────────────────────────────────────
ALERT_WEBHOOK_URL=

# ── Kafka ─────────────────────────────────────────────────────────────────────
KAFKA_BOOTSTRAP_SERVERS=kafka:29092
# Runtime Kafka clients consume these values. Local Compose defaults to PLAINTEXT;
# production should use SASL_SSL with broker-side TLS and credentials.
KAFKA_SECURITY_PROTOCOL=PLAINTEXT
KAFKA_SASL_MECHANISM=
KAFKA_SASL_USERNAME=
KAFKA_SASL_PASSWORD=
KAFKA_SSL_CAFILE=
KAFKA_SSL_CERTFILE=
KAFKA_SSL_KEYFILE=
KAFKA_SSL_PASSWORD=
KAFKA_SSL_CHECK_HOSTNAME=true

# ── Collector ─────────────────────────────────────────────────────────────────
# Local-only by default. Set trusted source CIDRs when receiving real syslog.
SYSLOG_ALLOWED_CIDRS=127.0.0.1/32,::1/128,172.16.0.0/12
# Kibana service token for ES
KIBANA_SERVICE_TOKEN=
